# Copy this file to server/.env and fill it in (the server reads it on start).
# server/.env is in .gitignore, so your keys and passwords never go to GitHub.
# On your live HTTPS server, remove the # below (secure login cookies). Keep it commented while testing on your computer.
# NODE_ENV=production
PORT=3000
# Where the database and uploaded images live. Leave empty to use server/data.
DATA_DIR=
# Long random string for admin login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Owner account created on first start
ADMIN_EMAIL=admin@wellitas.co.in
ADMIN_PASSWORD=
# Razorpay — Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local demo only: fake online payments when no Razorpay keys are set. Never use in production.
# PAYMENTS_DEMO=1
