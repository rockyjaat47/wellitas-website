# Copy to server/.env (VPS) or set in your host's Environment settings. Never commit real values.
NODE_ENV=production
PORT=3000
# Where the database and uploaded images live. Must be on a persistent disk.
DATA_DIR=/data
# Long random string for admin login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Owner account created on first start
ADMIN_EMAIL=admin@wellitas.co.in
ADMIN_PASSWORD=
# Razorpay — Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local demo only: fake online payments when no Razorpay keys are set. Never use in production.
# PAYMENTS_DEMO=1
